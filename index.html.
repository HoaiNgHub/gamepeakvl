<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Kho Game Của Tôi</title>
    <style>
        body { font-family: Arial, sans-serif; background-color: #121212; color: #fff; text-align: center; padding: 20px; }
        h1 { color: #00ff7f; }
        .grid { display: flex; flex-wrap: wrap; justify-content: center; gap: 15px; margin-top: 20px; }
        .card { background: #1e1e1e; border: 1px solid #333; border-radius: 8px; padding: 15px; width: 200px; text-decoration: none; color: white; transition: 0.3s; }
        .card:hover { transform: translateY(-5px); border-color: #00ff7f; }
        .card h3 { margin: 10px 0 5px 0; color: #00ff7f; }
    </style>
</head>
<body>

    <h1>🎮 KHO GAME GITHUB</h1>
    <p>Tổng hợp các link game hay nhất</p>

    <div class="grid">
        <!-- Bắt đầu 1 thẻ game -->
        <a href="https://github.com/link-game-1" target="_blank" class="card">
            <h3>Game Tên 1</h3>
            <p>Mô tả ngắn về game 1</p>
        </a>
        <!-- Kết thúc 1 thẻ game -->

        <a href="https://github.com/link-game-2" target="_blank" class="card">
            <h3>Game Tên 2</h3>
            <p>Mô tả ngắn về game 2</p>
        </a>
    </div>

</body>
</html>
